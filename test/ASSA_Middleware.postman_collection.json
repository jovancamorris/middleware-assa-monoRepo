			"name": "1. Health & Readiness (No Auth)",
			"item": [
				{
					"name": "Liveness Probe",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": ["{{baseUrl}}"],
							"path": ["health"]
						},
						"description": "Memeriksa apakah instance WSO2 MI aktif (Liveness Probe)."
					}
				},
				{
					"name": "Readiness Probe",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health/ready",
							"host": ["{{baseUrl}}"],
							"path": ["health", "ready"]
						},
						"description": "Memeriksa kesiapan service untuk menerima traffic (Readiness Probe)."
					}
				}
			]
		},
		{
			"name": "2. Branch Service (Scope: branches)",
			"item": [
				{
					"name": "Get Branches by Create Date (App A)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token_app_a}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "X-Correlation-Id",
								"value": "corr-postman-branch-001",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/branches/getByCreateDate?companyCode={{companyCode}}&dateStart=2020-01-01&dateEnd=2026-09-11&page=1&perPage=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "branches", "getByCreateDate"],
							"query": [
								{
									"key": "companyCode",
									"value": "{{companyCode}}"
								},
								{
									"key": "dateStart",
									"value": "2020-01-01"
								},
								{
									"key": "dateEnd",
									"value": "2026-09-11"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "perPage",
									"value": "10"
								}
							]
						},
						"description": "Mengambil data cabang ASSA berdasarkan tanggal pembuatan menggunakan token App A."
					}
				},
				{
					"name": "Get Branches by Create Date (QA)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token_qa}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
