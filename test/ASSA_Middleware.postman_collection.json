		{
			"name": "5. Security & Auth Guard Tests (Negative Cases)",
			"item": [
				{
					"name": "401 Unauthorized - Missing Token",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/branches/getByCreateDate?companyCode={{companyCode}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "branches", "getByCreateDate"],
							"query": [
								{
									"key": "companyCode",
									"value": "{{companyCode}}"
								}
							]
						},
						"description": "Ekspektasi: HTTP 401 Unauthorized karena header Authorization tidak dikirim."
					}
				},
				{
					"name": "401 Unauthorized - Invalid Token",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "token-ngawur-atau-tidak-terdaftar",
