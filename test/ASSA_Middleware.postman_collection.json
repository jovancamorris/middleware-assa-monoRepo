								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/branches/getByCreateDate?companyCode={{companyCode}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "branches", "getByCreateDate"],
							"query": [
								{
									"key": "companyCode",
									"value": "{{companyCode}}"
								}
							]
						},
						"description": "Ekspektasi: HTTP 401 Unauthorized karena token tidak cocok dengan aplikasi manapun di App Registry."
					}
				},
				{
					"name": "403 Forbidden - Insufficient Scope (App B -> Branch)",
