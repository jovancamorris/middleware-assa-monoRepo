{
	"info": {
		"_postman_id": "assa-middleware-api-collection",
		"name": "ASSA Middleware API Collection",
		"description": "Koleksi Postman resmi untuk pengujian manual ASSA Middleware (WSO2 Micro Integrator). Mencakup Health Check, Branch, Customer, Vehicle, serta Security Validation (Auth Guard 401 & 403).",
