<?xml version="1.0" encoding="UTF-8"?>
<localEntry key="SpkDuelistXmlXslt" xmlns="http://ws.apache.org/ns/synapse">
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:output method="xml" indent="yes" omit-xml-declaration="no" encoding="UTF-8"/>
  <xsl:param name="createdAt"/>
  <xsl:param name="ipAddress"/>

  <xsl:template name="atlas-date">
    <xsl:choose>
      <xsl:when test="string-length(.) &gt;= 10">
        <xsl:value-of select="concat(substring(., 9, 2), '.', substring(., 6, 2), '.', substring(., 1, 4))"/>
      </xsl:when>
      <xsl:otherwise><xsl:value-of select="."/></xsl:otherwise>
    </xsl:choose>
  </xsl:template>

  <xsl:template match="/">
    <Transaction xmlns="">
      <Header>
        <ID>ATLAS</ID>
        <TransGuID><xsl:value-of select="concat($createdAt, '-SPK')"/></TransGuID>
        <DocumentNumber><xsl:value-of select="//*[local-name()='noSpk'][1]"/></DocumentNumber>
        <FileType>XML</FileType>
        <IPAddress><xsl:value-of select="$ipAddress"/></IPAddress>
        <DestinationUser>SAP</DestinationUser>
        <Key1>ATLAS</Key1>
        <Key2>SPK</Key2>
        <DataLength>1</DataLength>
      </Header>
      <TransactionDatas>
        <TransactionData>
          <No_Polisi><xsl:value-of select="//*[local-name()='noPolisi'][1]"/></No_Polisi>
          <Business_Area><xsl:value-of select="//*[local-name()='businessArea'][1]"/></Business_Area>
          <Category><xsl:value-of select="//*[local-name()='category'][1]"/></Category>
          <Sub_Category><xsl:value-of select="//*[local-name()='subCategory'][1]"/></Sub_Category>
          <Vendor_ID><xsl:value-of select="//*[local-name()='vendorReferensi'][1]"/></Vendor_ID>
          <Total_Price><xsl:value-of select="//*[local-name()='totalPrice'][1]"/></Total_Price>
          <Invoice_Number><xsl:value-of select="//*[local-name()='invoiceNumber'][1]"/></Invoice_Number>
          <Invoice_Date><xsl:for-each select="//*[local-name()='invoiceDate'][1]"><xsl:call-template name="atlas-date"/></xsl:for-each></Invoice_Date>
          <Tax_InvoiceNo><xsl:value-of select="//*[local-name()='taxInvoiceNumber'][1]"/></Tax_InvoiceNo>
          <Tax_date><xsl:for-each select="//*[local-name()='taxInvoiceDate'][1]"><xsl:call-template name="atlas-date"/></xsl:for-each></Tax_date>
          <Details>
            <xsl:for-each select="//*[local-name()='details'][*[local-name()='description']] | //*[local-name()='details']/*[local-name()='details'][*[local-name()='description']] | //*[local-name()='details']/*[local-name()='jsonObject'][*[local-name()='description']]">
              <Detail>
                <Item_Desc><xsl:value-of select="*[local-name()='description']"/></Item_Desc>
                <Item_Qty><xsl:value-of select="*[local-name()='qty']"/></Item_Qty>
                <Item_Price><xsl:value-of select="*[local-name()='price']"/></Item_Price>
                <Komponen>
                  <xsl:choose>
                    <xsl:when test="*[local-name()='jenis'] = 'Parts'">Item</xsl:when>
                    <xsl:otherwise><xsl:value-of select="*[local-name()='jenis']"/></xsl:otherwise>
                  </xsl:choose>
                </Komponen>
              </Detail>
            </xsl:for-each>
          </Details>
        </TransactionData>
      </TransactionDatas>
    </Transaction>
  </xsl:template>
</xsl:stylesheet>
</localEntry>
