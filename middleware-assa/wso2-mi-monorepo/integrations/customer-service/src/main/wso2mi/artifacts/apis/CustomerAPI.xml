<?xml version="1.0" encoding="UTF-8"?>
<api context="/api/customers" name="CustomerAPI" xmlns="http://ws.apache.org/ns/synapse">
    <!-- ================================================================= -->
    <!-- Customer Domain API (ASSA Core SAP Integration)                   -->
    <!-- Sesuai CLEAN_ARCHITECTURE.md Bagian 4.1                           -->
    <!-- ================================================================= -->
    <resource methods="GET" uri-template="/getByCreateDate">
        <inSequence>
            <!-- 1. Mandatory Token Authentication (Auth Guard) -->
            <property name="requiredScope" value="customers" scope="default" type="STRING"/>
            <sequence key="AuthGuardSeq"/>

            <!-- 2. Orchestration Sequence -->
            <sequence key="CustomerGetByCreateDateSeq"/>
        </inSequence>
        <faultSequence>
            <sequence key="ErrorResponseSeq"/>
        </faultSequence>
    </resource>
</api>
