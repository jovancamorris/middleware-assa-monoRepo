<?xml version="1.0" encoding="UTF-8"?>
<sequence name="BranchGetByCreateDateSeq" trace="disable" xmlns="http://ws.apache.org/ns/synapse">
    <property name="companyCode" expression="$url:companyCode" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:companyCode) = 0">
        <then>
            <property name="companyCode" expression="get-property('file', 'default.companyCode')" scope="default" type="STRING"/>
            <filter xpath="string-length($ctx:companyCode) = 0">
                <then>
                    <property name="companyCode" expression="get-property('system', 'default.companyCode')" scope="default" type="STRING"/>
                </then>
            </filter>
            <filter xpath="string-length($ctx:companyCode) = 0">
                <then>
                    <property name="companyCode" value="1000" scope="default" type="STRING"/>
                </then>
            </filter>
        </then>
    </filter>

    <property name="dateStart" expression="$url:dateStart" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:dateStart) = 0">
        <then>
            <property name="dateStart" expression="get-property('file', 'default.dateStart')" scope="default" type="STRING"/>
            <filter xpath="string-length($ctx:dateStart) = 0">
                <then>
                    <property name="dateStart" expression="get-property('system', 'default.dateStart')" scope="default" type="STRING"/>
                </then>
            </filter>
            <filter xpath="string-length($ctx:dateStart) = 0">
                <then>
                    <property name="dateStart" value="2020-01-01" scope="default" type="STRING"/>
                </then>
            </filter>
        </then>
    </filter>

    <property name="dateEnd" expression="$url:dateEnd" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:dateEnd) = 0">
        <then>
            <property name="dateEnd" expression="get-property('file', 'default.dateEnd')" scope="default" type="STRING"/>
            <filter xpath="string-length($ctx:dateEnd) = 0">
                <then>
                    <property name="dateEnd" expression="get-property('system', 'default.dateEnd')" scope="default" type="STRING"/>
                </then>
            </filter>
            <filter xpath="string-length($ctx:dateEnd) = 0">
                <then>
                    <property name="dateEnd" value="2026-09-11" scope="default" type="STRING"/>
                </then>
            </filter>
        </then>
    </filter>

    <property name="api.endpoint" value="/api/branches/getByCreateDate" scope="default" type="STRING"/>
    <property name="api.params" expression="fn:concat('companyCode=', $ctx:companyCode, '&amp;dateStart=', $ctx:dateStart, '&amp;dateEnd=', $ctx:dateEnd)" scope="default" type="STRING"/>
    <sequence key="LogRequestSeq"/>
    <sequence key="IdempotencyGuardSeq"/>

    <property name="baseUrlConfigKey" value="sap.core.base.url" scope="default" type="STRING"/>
    <property name="envVarKey" value="SAP_CORE_BASE_URL" scope="default" type="STRING"/>
    <sequence key="ResolveBaseUrlSeq"/>

    <property name="sapApiPath" expression="get-property('file', 'sap.api.path.branch.getByCreateDate')" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:sapApiPath) = 0">
        <then>
            <property name="sapApiPath" value="/api/Branches/GetByCreateDate" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="uri.var.sapBackendUrl" expression="fn:concat($ctx:resolvedBaseUrl, $ctx:sapApiPath, '?companyCode=', $ctx:companyCode, '&amp;dateStart=', $ctx:dateStart, '&amp;dateEnd=', $ctx:dateEnd)" scope="default" type="STRING"/>
    <property name="targetEndpointKey" value="SapCoreDynamicEndpoint" scope="default" type="STRING"/>
    <sequence key="SafeApiCallWithRetrySeq"/>
</sequence>
