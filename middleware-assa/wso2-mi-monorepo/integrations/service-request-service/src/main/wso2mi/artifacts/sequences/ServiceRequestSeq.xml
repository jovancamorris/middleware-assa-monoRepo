<?xml version="1.0" encoding="UTF-8"?>
<sequence name="ServiceRequestSeq" onError="ErrorResponseSeq" trace="disable" xmlns="http://ws.apache.org/ns/synapse">
    <property name="sr_app_id" expression="json-eval($.app_id)" scope="default" type="STRING"/>
    <property name="sr_reff_number" expression="json-eval($.reff_number)" scope="default" type="STRING"/>
    <property name="sr_branch_code" expression="json-eval($.branch_code)" scope="default" type="STRING"/>
    <property name="sr_equipment_number" expression="json-eval($.equipment_number)" scope="default" type="STRING"/>
    <property name="sr_license_plate" expression="json-eval($.license_plate)" scope="default" type="STRING"/>
    <property name="sr_customer_code" expression="json-eval($.customer_code)" scope="default" type="STRING"/>
    <property name="sr_customer_name" expression="json-eval($.customer_name)" scope="default" type="STRING"/>
    <property name="sr_channel" expression="json-eval($.channel)" scope="default" type="STRING"/>
    <property name="sr_cp_title" expression="json-eval($.cp_title)" scope="default" type="STRING"/>
    <property name="sr_cp_name" expression="json-eval($.cp_name)" scope="default" type="STRING"/>
    <property name="sr_cp_phone" expression="json-eval($.cp_phone)" scope="default" type="STRING"/>
    <property name="sr_cp_email" expression="json-eval($.cp_email)" scope="default" type="STRING"/>
    <property name="sr_cp_address" expression="json-eval($.cp_address)" scope="default" type="STRING"/>
    <property name="sr_km" expression="json-eval($.km)" scope="default" type="STRING"/>
    <property name="sr_description" expression="json-eval($.description)" scope="default" type="STRING"/>
    <property name="sr_service_datetime" expression="json-eval($.service_datetime)" scope="default" type="STRING"/>
    <property name="sr_service_location" expression="json-eval($.service_location)" scope="default" type="STRING"/>
    <property name="sr_jenis_permintaan" expression="json-eval($.jenis_permintaan)" scope="default" type="STRING"/>
    <property name="sr_incident_datetime" expression="json-eval($.incident_datetime)" scope="default" type="STRING"/>
    <property name="sr_tipe_tiket" expression="json-eval($.tipe_tiket)" scope="default" type="STRING"/>
    <property name="sr_judul" expression="json-eval($.judul)" scope="default" type="STRING"/>
    <property name="sr_nama_kunjungan" expression="json-eval($.nama_kunjungan)" scope="default" type="STRING"/>
    <property name="sr_telepon_kunjungan" expression="json-eval($.telepon_kunjungan)" scope="default" type="STRING"/>
    <property name="sr_alamat_kunjungan" expression="json-eval($.alamat_kunjungan)" scope="default" type="STRING"/>
    <property name="sr_pool_name" expression="json-eval($.pool_name)" scope="default" type="STRING"/>
    <property name="sr_area_bengkel" expression="json-eval($.area_bengkel)" scope="default" type="STRING"/>
    <property name="sr_task" expression="json-eval($.task)" scope="default" type="STRING"/>
    <property name="sr_created_datetime" expression="json-eval($.created_datetime)" scope="default" type="STRING"/>
    <property name="sr_created_by" expression="json-eval($.created_by)" scope="default" type="STRING"/>
    <property name="sr_ticket_no" expression="json-eval($.ticket_no)" scope="default" type="STRING"/>

    <property name="originalRequestJson" expression="json-eval($)" scope="default" type="STRING"/>

    <filter xpath="string-length($ctx:sr_app_id) = 0">
        <then>
            <property name="ERROR_CODE" value="400" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Bad Request" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Field 'app_id' wajib diisi" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:sr_reff_number) = 0">
        <then>
            <property name="ERROR_CODE" value="400" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Bad Request" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Field 'reff_number' wajib diisi" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:sr_branch_code) = 0">
        <then>
            <property name="ERROR_CODE" value="400" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Bad Request" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Field 'branch_code' wajib diisi" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:sr_created_datetime) = 0">
        <then>
            <property name="ERROR_CODE" value="400" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Bad Request" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Field 'created_datetime' wajib diisi" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:sr_created_by) = 0">
        <then>
            <property name="ERROR_CODE" value="400" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Bad Request" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Field 'created_by' wajib diisi" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:sr_ticket_no) = 0">
        <then>
            <property name="ERROR_CODE" value="400" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Bad Request" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Field 'ticket_no' wajib diisi" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>

    <property name="api.endpoint" value="/api/service-requests" scope="default" type="STRING"/>
    <property name="httpMethod" value="POST" scope="default" type="STRING"/>
    <property name="api.params" expression="$ctx:originalRequestJson" scope="default" type="STRING"/>
    <sequence key="LogRequestSeq"/>
    <sequence key="IdempotencyGuardSeq"/>

    <clone id="SR_FANOUT" continueParent="false">
        <target sequence="SrToAtlasSeq"/>
        <target sequence="SrToExtServiceSeq"/>
    </clone>

    <aggregate id="SR_FANOUT">
        <completeCondition timeout="35">
            <messageCount min="2" max="2"/>
        </completeCondition>
        <onComplete expression="$body/*">
            <sequence key="SrAggregateResponseSeq"/>
        </onComplete>
    </aggregate>
</sequence>
