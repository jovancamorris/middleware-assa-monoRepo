<?xml version="1.0" encoding="UTF-8"?>
<sequence name="SrExtServiceErrorHandlerSeq" trace="disable" xmlns="http://ws.apache.org/ns/synapse">
    <log level="custom">
        <property name="BRANCH" value="SrToExtServiceSeq"/>
        <property name="STATUS" value="FAILED"/>
        <property name="ERROR_CODE" expression="$ctx:ERROR_CODE"/>
        <property name="ERROR_MESSAGE" expression="$ctx:ERROR_MESSAGE"/>
        <property name="ERROR_DETAIL" expression="$ctx:ERROR_DETAIL"/>
    </log>
    <property name="responseStatus" value="502" scope="default" type="STRING"/>
    <property name="errorMessage" expression="fn:concat('ASSA External Services Error: ', $ctx:ERROR_MESSAGE)" scope="default" type="STRING"/>
    <property name="responseBody" expression="$ctx:ERROR_DETAIL" scope="default" type="STRING"/>
    <property name="durationMs" value="0" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:currentAttempt) = 0">
        <then><property name="currentAttempt" value="1" scope="default" type="STRING"/></then>
    </filter>
    <filter xpath="string-length($ctx:maxAttempts) = 0">
        <then><property name="maxAttempts" value="10" scope="default" type="STRING"/></then>
    </filter>
    <filter xpath="string-length($ctx:api.endpoint) = 0">
        <then>
            <property name="api.endpoint" expression="$ctx:uri.var.extBackendUrl" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:api.params) = 0">
        <then>
            <property name="api.params" value="service_request_urlencoded" scope="default" type="STRING"/>
        </then>
    </filter>
    <sequence key="DbRecordAttemptLogSeq"/>
    <filter xpath="number($ctx:currentAttempt) &lt; number($ctx:maxAttempts)">
        <then>
            <property name="rawNextAttempt" expression="number($ctx:currentAttempt) + 1" scope="default" type="STRING"/>
            <property name="currentAttempt" expression="fn:substring-before(fn:concat($ctx:rawNextAttempt, '.'), '.')" scope="default" type="STRING"/>
            <log level="custom">
                <property name="RETRY" expression="fn:concat('Retrying extService on error, attempt ', $ctx:currentAttempt, ' of 10...')"/>
            </log>
            <dbreport>
                <connection><pool><driver>org.mariadb.jdbc.Driver</driver><url>jdbc:mariadb://localhost:3307/assa_middleware_db?useSSL=false&amp;allowPublicKeyRetrieval=true</url><user>root</user><password/></pool></connection>
                <statement><sql>DO SLEEP(1)</sql></statement>
            </dbreport>
            <sequence key="SrToExtServiceSeq"/>
        </then>
        <else>
            <payloadFactory media-type="xml">
                <format>
                    <srResult xmlns="">
                        <target>extService</target>
                        <status>FAILED</status>
                        <httpStatus>502</httpStatus>
                        <detail>Failed to reach ASSA External Services after 10 attempts: $1</detail>
                    </srResult>
                </format>
                <args>
                    <arg evaluator="xml" expression="$ctx:ERROR_MESSAGE"/>
                </args>
            </payloadFactory>
        </else>
    </filter>
</sequence>
