<?xml version="1.0" encoding="UTF-8"?>
<sequence name="SrToAtlasSeq" onError="SrAtlasErrorHandlerSeq" trace="disable" xmlns="http://ws.apache.org/ns/synapse">
    <property name="srAtlasEnabled" expression="get-property('env', 'SR_TARGET_ATLAS_ENABLED')" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:srAtlasEnabled) = 0">
        <then><property name="srAtlasEnabled" expression="get-property('system', 'sr.target.atlas.enabled')" scope="default" type="STRING"/></then>
    </filter>
    <filter xpath="string-length($ctx:srAtlasEnabled) = 0">
        <then><property name="srAtlasEnabled" expression="get-property('file', 'sr.target.atlas.enabled')" scope="default" type="STRING"/></then>
    </filter>
    <filter xpath="string-length($ctx:srAtlasEnabled) = 0">
        <then><property name="srAtlasEnabled" value="false" scope="default" type="STRING"/></then>
    </filter>

    <filter xpath="$ctx:srAtlasEnabled = 'false' or $ctx:srAtlasEnabled = '0'">
        <then>
            <payloadFactory media-type="xml">
                <format>
                    <srResult xmlns="">
                        <target>atlas</target>
                        <status>SKIPPED</status>
                        <httpStatus>200</httpStatus>
                        <detail>API ATLAS disabled via toggle (sr.target.atlas.enabled=false)</detail>
                    </srResult>
                </format>
            </payloadFactory>
        </then>
        <else>
            <property name="atlasBaseUrl" expression="get-property('env', 'SR_TARGET_ATLAS_BASE_URL')" scope="default" type="STRING"/>
            <filter xpath="string-length($ctx:atlasBaseUrl) = 0 or contains($ctx:atlasBaseUrl, 'atlas-api.assa.id')">
                <then>
                    <property name="atlasBaseUrl" expression="get-property('system', 'sr.target.atlas.base.url')" scope="default" type="STRING"/>
                </then>
            </filter>
            <filter xpath="string-length($ctx:atlasBaseUrl) = 0 or contains($ctx:atlasBaseUrl, 'atlas-api.assa.id')">
                <then>
                    <property name="atlasBaseUrl" expression="get-property('file', 'sr.target.atlas.base.url')" scope="default" type="STRING"/>
                </then>
            </filter>
            <filter xpath="string-length($ctx:atlasBaseUrl) = 0 or contains($ctx:atlasBaseUrl, 'atlas-api.assa.id')">
                <then>
                    <property name="atlasBaseUrl" value="https://fe.atlas-dev.assa.id" scope="default" type="STRING"/>
                </then>
            </filter>

            <property name="atlasPath" expression="get-property('env', 'SR_TARGET_ATLAS_PATH')" scope="default" type="STRING"/>
            <filter xpath="string-length($ctx:atlasPath) = 0">
                <then>
                    <property name="atlasPath" expression="get-property('system', 'sr.target.atlas.path')" scope="default" type="STRING"/>
                </then>
            </filter>
            <filter xpath="string-length($ctx:atlasPath) = 0">
                <then>
                    <property name="atlasPath" expression="get-property('file', 'sr.target.atlas.path')" scope="default" type="STRING"/>
                </then>
            </filter>
            <filter xpath="string-length($ctx:atlasPath) = 0">
                <then>
                    <property name="atlasPath" value="/api/vendor/public/service-requests" scope="default" type="STRING"/>
                </then>
            </filter>

            <!-- Prefer SR_TARGET_ATLAS_API_KEY or SR_TARGET_ATLAS_APIKEY, ignoring placeholder values -->
            <property name="atlasApiKey" expression="get-property('env', 'SR_TARGET_ATLAS_API_KEY')" scope="default" type="STRING"/>
            <filter xpath="string-length($ctx:atlasApiKey) = 0 or $ctx:atlasApiKey = 'ATLAS_PLACEHOLDER_KEY' or starts-with($ctx:atlasApiKey, 'ATLAS_')">
                <then>
                    <property name="atlasApiKey" expression="get-property('env', 'SR_TARGET_ATLAS_APIKEY')" scope="default" type="STRING"/>
                </then>
            </filter>
            <filter xpath="string-length($ctx:atlasApiKey) = 0 or $ctx:atlasApiKey = 'ATLAS_PLACEHOLDER_KEY' or starts-with($ctx:atlasApiKey, 'ATLAS_')">
                <then>
                    <property name="atlasApiKey" expression="get-property('system', 'sr.target.atlas.apikey')" scope="default" type="STRING"/>
                </then>
            </filter>
            <filter xpath="string-length($ctx:atlasApiKey) = 0 or $ctx:atlasApiKey = 'ATLAS_PLACEHOLDER_KEY' or starts-with($ctx:atlasApiKey, 'ATLAS_')">
                <then>
                    <property name="atlasApiKey" expression="get-property('file', 'sr.target.atlas.apikey')" scope="default" type="STRING"/>
                </then>
            </filter>

            <property name="uri.var.atlasBackendUrl" expression="fn:concat($ctx:atlasBaseUrl, $ctx:atlasPath)" scope="default" type="STRING"/>
            <property name="api.endpoint" expression="$ctx:uri.var.atlasBackendUrl" scope="default" type="STRING"/>
            <property name="api.params" expression="$ctx:originalRequestJson" scope="default" type="STRING"/>
            <filter xpath="string-length($ctx:currentAttempt) = 0">
                <then><property name="currentAttempt" value="1" scope="default" type="STRING"/></then>
            </filter>
            <property name="maxAttempts" value="10" scope="default" type="STRING"/>
            <property name="retryIntervalSec" value="1" scope="default" type="STRING"/>
            <payloadFactory media-type="json">
                <format>$1</format>
                <args>
                    <arg evaluator="xml" expression="$ctx:originalRequestJson"/>
                </args>
            </payloadFactory>
            <!-- Remove any client-side headers that could cause duplicates or CORS conflicts -->
            <header name="Authorization" action="remove" scope="transport"/>
            <header name="X-API-Key" action="remove" scope="transport"/>
            <header name="x-api-key" action="remove" scope="transport"/>
            <header name="Origin" action="remove" scope="transport"/>
            <header name="origin" action="remove" scope="transport"/>

            <filter xpath="string-length($ctx:atlasApiKey) &gt; 0 and $ctx:atlasApiKey != '__USE_SECURE_VAULT__'">
                <then>
                    <header name="X-API-Key" expression="$ctx:atlasApiKey" scope="transport"/>
                </then>
            </filter>
            <property name="atlasOrigin" expression="get-property('env', 'SR_TARGET_ATLAS_ORIGIN')" scope="default" type="STRING"/>
            <filter xpath="string-length($ctx:atlasOrigin) = 0">
                <then><property name="atlasOrigin" value="https://devmiddleware1.assa.id" scope="default" type="STRING"/></then>
            </filter>
            <header name="Origin" expression="$ctx:atlasOrigin" scope="transport"/>
            <header name="Content-Type" value="application/json" scope="transport"/>
            <property name="messageType" value="application/json" scope="axis2"/>
            <property name="ContentType" value="application/json" scope="axis2"/>
            <property name="HTTP_METHOD" value="POST" scope="axis2"/>
            <property name="REST_URL_POSTFIX" action="remove" scope="axis2"/>

            <log level="custom">
                <property name="ATLAS_OUTBOUND" expression="fn:concat('Target: ', $ctx:uri.var.atlasBackendUrl, ' | Origin: ', $ctx:atlasOrigin, ' | KeyPrefix: ', fn:substring($ctx:atlasApiKey, 1, 10))"/>
            </log>

            <property name="callStartTime" expression="get-property('SYSTEM_TIME')" scope="default" type="STRING"/>
            <call>
                <endpoint key="AtlasPostEndpoint"/>
            </call>
            <property name="callEndTime" expression="get-property('SYSTEM_TIME')" scope="default" type="STRING"/>
            <property name="rawDurationMs" expression="number($ctx:callEndTime) - number($ctx:callStartTime)" scope="default" type="STRING"/>
            <property name="durationMs" expression="fn:substring-before(fn:concat($ctx:rawDurationMs, '.'), '.')" scope="default" type="STRING"/>
            <filter xpath="string-length($ctx:durationMs) = 0 or number($ctx:durationMs) &lt; 0">
                <then>
                    <property name="durationMs" value="0" scope="default" type="STRING"/>
                </then>
            </filter>
            <property name="responseStatus" expression="$axis2:HTTP_SC" scope="default" type="STRING"/>
            <filter xpath="string-length($ctx:responseStatus) = 0">
                <then>
                    <property name="responseStatus" value="200" scope="default" type="STRING"/>
                </then>
            </filter>
            <property name="responseBody" expression="json-eval($)" scope="default" type="STRING"/>
            <log level="custom">
                <property name="ATLAS_INBOUND" expression="fn:concat('HTTP ', $ctx:responseStatus, ' | Body: ', $ctx:responseBody)"/>
            </log>
            <property name="errorMessage" value="None" scope="default" type="STRING"/>
            <sequence key="DbRecordAttemptLogSeq"/>
            <filter xpath="number($ctx:responseStatus) &gt;= 200 and number($ctx:responseStatus) &lt; 300">
                <then>
                    <payloadFactory media-type="xml">
                        <format>
                            <srResult xmlns="">
                                <target>atlas</target>
                                <status>SUCCESS</status>
                                <httpStatus>$1</httpStatus>
                                <detail>Success forwarded to API ATLAS</detail>
                            </srResult>
                        </format>
                        <args>
                            <arg evaluator="xml" expression="$ctx:responseStatus"/>
                        </args>
                    </payloadFactory>
                </then>
                <else>
                    <property name="errorMessage" expression="fn:concat('Forward failed with status ', $ctx:responseStatus)" scope="default" type="STRING"/>
                    <filter xpath="number($ctx:currentAttempt) &lt; number($ctx:maxAttempts)">
                        <then>
                            <property name="rawNextAttempt" expression="number($ctx:currentAttempt) + 1" scope="default" type="STRING"/>
                            <property name="currentAttempt" expression="fn:substring-before(fn:concat($ctx:rawNextAttempt, '.'), '.')" scope="default" type="STRING"/>
                            <log level="custom">
                                <property name="RETRY" expression="fn:concat('Retrying atlas attempt ', $ctx:currentAttempt, ' of 10...')"/>
                            </log>
                            <dbreport>
                                <connection><pool><driver key="conf:/repository/assa/db/driver"/><url key="conf:/repository/assa/db/url"/><user key="conf:/repository/assa/db/username"/><password key="conf:/repository/assa/db/password"/></pool></connection>
                                <statement><sql>DO SLEEP(1)</sql></statement>
                            </dbreport>
                            <sequence key="SrToAtlasSeq"/>
                        </then>
                        <else>
                            <payloadFactory media-type="xml">
                                <format>
                                    <srResult xmlns="">
                                        <target>atlas</target>
                                        <status>FAILED</status>
                                        <httpStatus>$1</httpStatus>
                                        <detail>Forward to API ATLAS failed after 10 attempts</detail>
                                    </srResult>
                                </format>
                                <args>
                                    <arg evaluator="xml" expression="$ctx:responseStatus"/>
                                </args>
                            </payloadFactory>
                        </else>
                    </filter>
                </else>
            </filter>
        </else>
    </filter>
</sequence>
