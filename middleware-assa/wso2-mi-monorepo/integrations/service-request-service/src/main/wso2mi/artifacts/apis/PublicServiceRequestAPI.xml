<?xml version="1.0" encoding="UTF-8"?>
<api context="/api/vendor/public/service-requests" name="PublicServiceRequestAPI" xmlns="http://ws.apache.org/ns/synapse">
    <resource methods="POST" url-mapping="/*">
        <inSequence>
            <property name="requiredScope" value="service_requests" scope="default" type="STRING"/>
            <sequence key="AuthGuardSeq"/>
            <sequence key="ServiceRequestSeq"/>
        </inSequence>
        <faultSequence>
            <sequence key="ErrorResponseSeq"/>
        </faultSequence>
    </resource>
    <resource methods="GET" url-mapping="/*">
        <inSequence>
            <property name="requiredScope" value="service_requests" scope="default" type="STRING"/>
            <sequence key="AuthGuardSeq"/>
            <sequence key="ServiceRequestGetSeq"/>
        </inSequence>
        <faultSequence>
            <sequence key="ErrorResponseSeq"/>
        </faultSequence>
    </resource>
</api>
