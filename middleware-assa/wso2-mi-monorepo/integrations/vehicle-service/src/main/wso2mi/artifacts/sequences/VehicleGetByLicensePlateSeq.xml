<?xml version="1.0" encoding="UTF-8"?>
<sequence name="VehicleGetByLicensePlateSeq" trace="disable" xmlns="http://ws.apache.org/ns/synapse">
    <!-- 1. Parameter Extraction -->
    <property name="companyCode" expression="$url:companyCode" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:companyCode) = 0">
        <then>
            <property name="companyCode" expression="get-property('file', 'default.companyCode')" scope="default" type="STRING"/>
        </then>
    </filter>

    <!-- Support plat_no (primary) and aliases: plate_no, licensePlate, plateNo -->
    <property name="platNo" expression="$url:plat_no" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:platNo) = 0">
        <then>
            <property name="platNo" expression="$url:plate_no" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:platNo) = 0">
        <then>
            <property name="platNo" expression="$url:licensePlate" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:platNo) = 0">
        <then>
            <property name="platNo" expression="$url:plateNo" scope="default" type="STRING"/>
        </then>
    </filter>
    <property name="plateNo" expression="$ctx:platNo" scope="default" type="STRING"/>

    <!-- Pagination parameters identical to Customer service (page, perPage) -->
    <property name="page" expression="$url:page" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:page) = 0">
        <then>
            <property name="page" expression="get-property('file', 'default.page')" scope="default" type="STRING"/>
            <filter xpath="string-length($ctx:page) = 0">
                <then>
                    <property name="page" expression="get-property('system', 'default.page')" scope="default" type="STRING"/>
                </then>
            </filter>
        </then>
    </filter>

    <property name="perPage" expression="$url:perPage" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:perPage) = 0">
        <then>
            <property name="perPage" expression="$url:per_page" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:perPage) = 0">
        <then>
            <property name="perPage" expression="get-property('file', 'default.perPage')" scope="default" type="STRING"/>
            <filter xpath="string-length($ctx:perPage) = 0">
                <then>
                    <property name="perPage" expression="get-property('system', 'default.perPage')" scope="default" type="STRING"/>
                </then>
            </filter>
        </then>
    </filter>

    <property name="limitParam" expression="$url:limit" scope="default" type="STRING"/>
    <property name="offsetParam" expression="$url:offset" scope="default" type="STRING"/>

    <!-- Filter parameters: equipment_no, branchCode, status_id, color -->
    <property name="equipmentNo" expression="$url:equipment_no" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:equipmentNo) = 0">
        <then>
            <property name="equipmentNo" expression="$url:equipmentNo" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="branchCode" expression="$url:branchCode" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:branchCode) = 0">
        <then>
            <property name="branchCode" expression="$url:branch_code" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="statusId" expression="$url:status_id" scope="default" type="STRING"/>
    <property name="colorParam" expression="$url:color" scope="default" type="STRING"/>

    <!-- Support single-field search filterBy (and aliases: filterdby, filteredBy, filter_by) -->
    <property name="filterBy" expression="$url:filterBy" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:filterBy) = 0">
        <then>
            <property name="filterBy" expression="$url:filterdby" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:filterBy) = 0">
        <then>
            <property name="filterBy" expression="$url:filteredBy" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:filterBy) = 0">
        <then>
            <property name="filterBy" expression="$url:filter_by" scope="default" type="STRING"/>
        </then>
    </filter>

    <!-- 2. Normalization & Pagination Calculation Script -->
    <script language="js"><![CDATA[
        // If filterBy is provided, check if it maps to plate_no, equipment_no, branchCode, status_id, or color
        var rawFilter = mc.getProperty("filterBy");
        var rawPlat = mc.getProperty("platNo") || mc.getProperty("plateNo");
        var rawEquip = mc.getProperty("equipmentNo");
        var rawBranch = mc.getProperty("branchCode");
        var rawStatus = mc.getProperty("statusId");
        var rawColor = mc.getProperty("colorParam");

        if (rawFilter) {
            var trimmedFilter = String(rawFilter).trim();
            var platePattern = /^[A-Za-z]{1,2}[\s-]?\d{1,4}([\s-]?[A-Za-z]{1,3})?$/;
            if (!rawPlat && platePattern.test(trimmedFilter)) {
                rawPlat = trimmedFilter;
            } else if (!rawEquip && /^\d{7,10}$/.test(trimmedFilter)) {
                mc.setProperty("equipmentNo", trimmedFilter);
            } else if (!rawBranch && /^\d{4}$/.test(trimmedFilter)) {
                mc.setProperty("branchCode", trimmedFilter);
            } else if (!rawStatus && /^\d{1,2}$/.test(trimmedFilter)) {
                mc.setProperty("statusId", trimmedFilter);
            } else if (!rawColor && /^[A-Za-z]+(\s+[A-Za-z0-9]+)*$/.test(trimmedFilter)) {
                mc.setProperty("colorParam", trimmedFilter);
            }
        }

        // License plate normalization (e.g. "B 9065 UCU" -> "B-9065-UCU", "B9065UCU" -> "B-9065-UCU")
        if (rawPlat) {
            var s = String(rawPlat).trim();
            if (s.indexOf('-') === -1) {
                if (s.indexOf(' ') !== -1) {
                    s = s.replace(/\s+/g, '-');
                } else {
                    var m = s.match(/^([A-Za-z]{1,2})(\d+)([A-Za-z]*)$/);
                    if (m) {
                        s = m[3] ? m[1] + '-' + m[2] + '-' + m[3] : m[1] + '-' + m[2];
                    }
                }
            }
            mc.setProperty("plateNo", s);
            mc.setProperty("platNo", s);
        }

        // Pagination calculation (page, perPage -> limit, offset)
        var rawPage = mc.getProperty("page");
        var rawPerPage = mc.getProperty("perPage");
        var rawLimit = mc.getProperty("limitParam");
        var rawOffset = mc.getProperty("offsetParam");

        var perPage = parseInt(rawPerPage, 10);
        if (!(perPage > 0) && rawLimit) {
            perPage = parseInt(rawLimit, 10);
        }
        if (!(perPage > 0)) {
            perPage = 10;
        }

        var page = parseInt(rawPage, 10);
        if (!(page > 0) && rawOffset) {
            var offsetVal = parseInt(rawOffset, 10);
            if (offsetVal >= 0) {
                page = Math.floor(offsetVal / perPage) + 1;
            }
        }
        if (!(page > 0)) {
            page = 1;
        }

        var offset = (page - 1) * perPage;
        mc.setProperty("page", String(page));
        mc.setProperty("perPage", String(perPage));
        mc.setProperty("limitParam", String(perPage));
        mc.setProperty("offsetParam", String(offset));
    ]]></script>

    <!-- 3. Observability Logging & Idempotency Guard -->
    <filter xpath="string-length($ctx:api.endpoint) = 0">
        <then>
            <property name="api.endpoint" value="/api/vehicles/getByLicensePlate" scope="default" type="STRING"/>
        </then>
    </filter>
    <property name="api.params" expression="fn:concat('plat_no=', $ctx:plateNo, '&amp;page=', $ctx:page, '&amp;perPage=', $ctx:perPage, '&amp;equipment_no=', $ctx:equipmentNo, '&amp;branchCode=', $ctx:branchCode, '&amp;filterBy=', $ctx:filterBy)" scope="default" type="STRING"/>
    <sequence key="LogRequestSeq"/>
    <sequence key="IdempotencyGuardSeq"/>

    <!-- 4. Base URL Resolution & External Vehicle API Config -->
    <property name="baseUrlConfigKey" value="assa.ext.base.url" scope="default" type="STRING"/>
    <property name="envVarKey" value="ASSA_EXT_BASE_URL" scope="default" type="STRING"/>
    <sequence key="ResolveBaseUrlSeq"/>

    <property name="vehicleApiPath" expression="get-property('file', 'assa.api.path.vehicle')" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:vehicleApiPath) = 0">
        <then>
            <property name="vehicleApiPath" value="/api/vehicleatlas" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="vehicleApiKey" expression="get-property('env', 'ASSA_EXT_VEHICLE_APIKEY')" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:vehicleApiKey) = 0">
        <then>
            <property name="vehicleApiKey" expression="get-property('system', 'assa.ext.vehicle.apikey')" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:vehicleApiKey) = 0">
        <then>
            <property name="vehicleApiKey" expression="get-property('file', 'assa.ext.vehicle.apikey')" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:vehicleApiKey) = 0">
        <then>
            <property name="vehicleApiKey" value="XxfOtMSMhjoMQEPUHju4u7jkCEpZ09" scope="default" type="STRING"/>
        </then>
    </filter>

    <header name="Authorization" action="remove" scope="transport"/>
    <header name="Key" expression="$ctx:vehicleApiKey" scope="transport"/>
    <header name="x-api-key" expression="$ctx:vehicleApiKey" scope="transport"/>

    <!-- 5. Compose Query String for Upstream Vehicle Atlas -->
    <property name="queryString" value="" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:plateNo) &gt; 0">
        <then>
            <property name="queryString" expression="fn:concat($ctx:queryString, '&amp;plate_no=', $ctx:plateNo)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:equipmentNo) &gt; 0">
        <then>
            <property name="queryString" expression="fn:concat($ctx:queryString, '&amp;equipment_no=', $ctx:equipmentNo)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:branchCode) &gt; 0">
        <then>
            <property name="queryString" expression="fn:concat($ctx:queryString, '&amp;branch_code=', $ctx:branchCode)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:limitParam) &gt; 0">
        <then>
            <property name="queryString" expression="fn:concat($ctx:queryString, '&amp;limit=', $ctx:limitParam)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:offsetParam) &gt; 0">
        <then>
            <property name="queryString" expression="fn:concat($ctx:queryString, '&amp;offset=', $ctx:offsetParam)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:statusId) &gt; 0">
        <then>
            <property name="queryString" expression="fn:concat($ctx:queryString, '&amp;status_id=', $ctx:statusId)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:colorParam) &gt; 0">
        <then>
            <property name="queryString" expression="fn:concat($ctx:queryString, '&amp;color=', $ctx:colorParam)" scope="default" type="STRING"/>
        </then>
    </filter>

    <filter xpath="fn:starts-with($ctx:queryString, '&amp;')">
        <then>
            <property name="cleanQuery" expression="fn:substring($ctx:queryString, 2)" scope="default" type="STRING"/>
        </then>
        <else>
            <property name="cleanQuery" expression="$ctx:queryString" scope="default" type="STRING"/>
        </else>
    </filter>

    <filter xpath="string-length($ctx:cleanQuery) &gt; 0">
        <then>
            <property name="uri.var.extBackendUrl" expression="fn:concat($ctx:resolvedBaseUrl, $ctx:vehicleApiPath, '?', $ctx:cleanQuery)" scope="default" type="STRING"/>
        </then>
        <else>
            <property name="uri.var.extBackendUrl" expression="fn:concat($ctx:resolvedBaseUrl, $ctx:vehicleApiPath)" scope="default" type="STRING"/>
        </else>
    </filter>

    <!-- 6. Execute Safe API Call with Generic Pagination Enabled -->
    <property name="paginationEnabled" value="true" scope="default" type="STRING"/>
    <property name="targetEndpointKey" value="ExtServiceDynamicEndpoint" scope="default" type="STRING"/>
    <sequence key="SafeApiCallWithRetrySeq"/>
</sequence>
