<?xml version="1.0" encoding="UTF-8"?>
<api context="/health" name="HealthAPI" xmlns="http://ws.apache.org/ns/synapse">
    <!-- Liveness Probe -->
    <resource methods="GET" uri-template="/">
        <inSequence>
            <property name="checkType" value="liveness" scope="default" type="STRING"/>
            <sequence key="HealthCheckSeq"/>
        </inSequence>
        <faultSequence>
            <sequence key="ErrorResponseSeq"/>
        </faultSequence>
    </resource>

    <!-- Readiness Probe -->
    <resource methods="GET" uri-template="/ready">
        <inSequence>
            <property name="checkType" value="readiness" scope="default" type="STRING"/>
            <sequence key="HealthCheckSeq"/>
        </inSequence>
        <faultSequence>
            <sequence key="ErrorResponseSeq"/>
        </faultSequence>
    </resource>
</api>
