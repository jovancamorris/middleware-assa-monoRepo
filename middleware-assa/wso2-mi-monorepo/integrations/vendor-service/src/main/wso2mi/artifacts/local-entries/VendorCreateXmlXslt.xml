<?xml version="1.0" encoding="UTF-8"?>
<localEntry key="VendorCreateXmlXslt" xmlns="http://ws.apache.org/ns/synapse">
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:output method="xml" indent="yes" omit-xml-declaration="no" encoding="UTF-8"/>
  <xsl:param name="atlasId" select="'ATLAS'"/>
  <xsl:param name="transGuId"/>
  <xsl:param name="documentNumber"/>
  <xsl:param name="ipAddress" select="'127.0.0.1'"/>
  <xsl:param name="destinationUser" select="'SAP'"/>
  <xsl:param name="key1" select="'ATLAS'"/>
  <xsl:param name="key2" select="'VMD'"/>
  <xsl:param name="topFormatted"/>
  <xsl:template match="/">
    <Transaction xmlns="">
      <Header>
        <ID><xsl:value-of select="$atlasId"/></ID>
        <TransGuID><xsl:value-of select="$transGuId"/></TransGuID>
        <DocumentNumber><xsl:value-of select="$documentNumber"/></DocumentNumber>
        <FileType>XML</FileType>
        <IPAddress><xsl:value-of select="$ipAddress"/></IPAddress>
        <DestinationUser><xsl:value-of select="$destinationUser"/></DestinationUser>
        <Key1><xsl:value-of select="$key1"/></Key1>
        <Key2><xsl:value-of select="$key2"/></Key2>
        <DataLength>1</DataLength>
      </Header>
      <TransactionDatas>
        <TransactionData>
          <Vendor_ID><xsl:value-of select="(//Vendor_ID | //vendor_id | //vendorId)[1]"/></Vendor_ID>
          <Company_Code>
            <xsl:choose>
              <xsl:when test="(//Company_Code | //company_code | //companyCode)[1] and normalize-space((//Company_Code | //company_code | //companyCode)[1]) != ''">
                <xsl:value-of select="normalize-space((//Company_Code | //company_code | //companyCode)[1])"/>
              </xsl:when>
              <xsl:otherwise>1000</xsl:otherwise>
            </xsl:choose>
          </Company_Code>
          <Company_Name><xsl:value-of select="(//Company_Name | //company_name | //companyName)[1]"/></Company_Name>
          <Vendor_Type><xsl:value-of select="(//Vendor_Type | //vendor_type | //vendorType)[1]"/></Vendor_Type>
          <Account_Number><xsl:value-of select="(//Account_Number | //account_number | //accountNumber)[1]"/></Account_Number>
          <Account_Name><xsl:value-of select="(//Account_Name | //account_name | //accountName)[1]"/></Account_Name>
          <Bank_Name><xsl:value-of select="(//Bank_Name | //bank_name | //bankName)[1]"/></Bank_Name>
          <HO_Email><xsl:value-of select="(//HO_Email | //ho_email | //hoEmail)[1]"/></HO_Email>
          <HO_Phone><xsl:value-of select="(//HO_Phone | //ho_phone | //hoPhone)[1]"/></HO_Phone>
          <HO_Address><xsl:value-of select="(//HO_Address | //ho_address | //hoAddress)[1]"/></HO_Address>
          <Contact_Name><xsl:value-of select="(//Contact_Name | //contact_name | //contactName)[1]"/></Contact_Name>
          <Contact_Phone><xsl:value-of select="(//Contact_Phone | //contact_phone | //contactPhone)[1]"/></Contact_Phone>
          <NPWP><xsl:value-of select="(//NPWP | //npwp)[1]"/></NPWP>
          <TOP>
            <xsl:choose>
              <xsl:when test="$topFormatted and normalize-space($topFormatted) != ''">
                <xsl:value-of select="normalize-space($topFormatted)"/>
              </xsl:when>
              <xsl:otherwise>
                <xsl:value-of select="(//TOP | //top)[1]"/>
              </xsl:otherwise>
            </xsl:choose>
          </TOP>
          <Account_Group><xsl:value-of select="(//Account_Group | //account_group | //accountGroup)[1]"/></Account_Group>
          <GL_Account><xsl:value-of select="(//GL_Account | //gl_account | //glAccount)[1]"/></GL_Account>
        </TransactionData>
      </TransactionDatas>
    </Transaction>
  </xsl:template>
</xsl:stylesheet>
</localEntry>
