<?xml version="1.0" encoding="UTF-8"?>
<inboundEndpoint name="VendorUploadInbound" protocol="file" sequence="VendorInboundCallbackSeq" onError="VendorInboundFaultSeq" suspend="false" xmlns="http://ws.apache.org/ns/synapse">
    <!-- ================================================================= -->
    <!-- Vendor Upload Inbound Endpoint (FTP VFS Poller for SAP Responses) -->
    <!-- Referensi: notes/GUIDE_IMPL_VENDOR_CALLBACK_INBOUND.md            -->
    <!-- ================================================================= -->
    <parameters>
        <parameter name="interval">60000</parameter>
        <parameter name="sequential">true</parameter>
        <parameter name="coordination">true</parameter>
        <parameter name="transport.vfs.FileURI">$SYSTEM:FTP_VENDOR_INBOUND_FILE_URI</parameter>
        <parameter name="transport.vfs.ContentType">application/xml</parameter>
        <parameter name="transport.vfs.FileNamePattern">.*\.xml</parameter>
        <parameter name="transport.vfs.ActionAfterProcess">MOVE</parameter>
        <parameter name="transport.vfs.MoveAfterProcess">$SYSTEM:FTP_VENDOR_INBOUND_MOVE_SUCCESS</parameter>
        <parameter name="transport.vfs.ActionAfterFailure">MOVE</parameter>
        <parameter name="transport.vfs.MoveAfterFailure">$SYSTEM:FTP_VENDOR_INBOUND_MOVE_FAILED</parameter>
        <parameter name="transport.vfs.AutoLockRelease">true</parameter>
        <parameter name="transport.vfs.LockReleaseSameNode">true</parameter>
    </parameters>
</inboundEndpoint>
