<?xml version="1.0" encoding="UTF-8"?>
<sequence name="VendorCreateSeq" onError="ErrorResponseSeq" trace="disable" xmlns="http://ws.apache.org/ns/synapse">
    <!-- ================================================================= -->
    <!-- 1. Extract JSON Payload & Save Original Copy                      -->
    <!-- Referensi: GUIDE_VENDOR_CREATE_XML_FTP_V2.md                      -->
    <!-- ================================================================= -->
    <property name="originalPayload" expression="json-eval($)" scope="default" type="STRING"/>

    <!-- Field extractions V2 (prioritizing exact XML tag casing) -->
    <property name="companyCode" expression="json-eval($.Company_Code)" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:companyCode) = 0">
        <then>
            <property name="companyCode" expression="json-eval($.company_code)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:companyCode) = 0">
        <then>
            <property name="companyCode" expression="json-eval($.companyCode)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:companyCode) = 0">
        <then>
            <property name="companyCode" expression="get-property('file', 'vmd.default.companyCode')" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:companyCode) = 0">
        <then>
            <property name="companyCode" value="1000" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="vendorId" expression="json-eval($.Vendor_ID)" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:vendorId) = 0">
        <then>
            <property name="vendorId" expression="json-eval($.vendor_id)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:vendorId) = 0">
        <then>
            <property name="vendorId" expression="json-eval($.vendorId)" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="vendorType" expression="json-eval($.Vendor_Type)" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:vendorType) = 0">
        <then>
            <property name="vendorType" expression="json-eval($.vendor_type)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:vendorType) = 0">
        <then>
            <property name="vendorType" expression="json-eval($.vendorType)" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="companyName" expression="json-eval($.Company_Name)" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:companyName) = 0">
        <then>
            <property name="companyName" expression="json-eval($.company_name)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:companyName) = 0">
        <then>
            <property name="companyName" expression="json-eval($.companyName)" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="accountNumber" expression="json-eval($.Account_Number)" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:accountNumber) = 0">
        <then>
            <property name="accountNumber" expression="json-eval($.account_number)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:accountNumber) = 0">
        <then>
            <property name="accountNumber" expression="json-eval($.accountNumber)" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="accountName" expression="json-eval($.Account_Name)" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:accountName) = 0">
        <then>
            <property name="accountName" expression="json-eval($.account_name)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:accountName) = 0">
        <then>
            <property name="accountName" expression="json-eval($.accountName)" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="bankName" expression="json-eval($.Bank_Name)" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:bankName) = 0">
        <then>
            <property name="bankName" expression="json-eval($.bank_name)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:bankName) = 0">
        <then>
            <property name="bankName" expression="json-eval($.bankName)" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="hoEmail" expression="json-eval($.HO_Email)" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:hoEmail) = 0">
        <then>
            <property name="hoEmail" expression="json-eval($.ho_email)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:hoEmail) = 0">
        <then>
            <property name="hoEmail" expression="json-eval($.hoEmail)" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="hoPhone" expression="json-eval($.HO_Phone)" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:hoPhone) = 0">
        <then>
            <property name="hoPhone" expression="json-eval($.ho_phone)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:hoPhone) = 0">
        <then>
            <property name="hoPhone" expression="json-eval($.hoPhone)" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="hoAddress" expression="json-eval($.HO_Address)" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:hoAddress) = 0">
        <then>
            <property name="hoAddress" expression="json-eval($.ho_address)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:hoAddress) = 0">
        <then>
            <property name="hoAddress" expression="json-eval($.hoAddress)" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="contactName" expression="json-eval($.Contact_Name)" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:contactName) = 0">
        <then>
            <property name="contactName" expression="json-eval($.contact_name)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:contactName) = 0">
        <then>
            <property name="contactName" expression="json-eval($.contactName)" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="contactPhone" expression="json-eval($.Contact_Phone)" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:contactPhone) = 0">
        <then>
            <property name="contactPhone" expression="json-eval($.contact_phone)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:contactPhone) = 0">
        <then>
            <property name="contactPhone" expression="json-eval($.contactPhone)" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="npwp" expression="json-eval($.NPWP)" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:npwp) = 0">
        <then>
            <property name="npwp" expression="json-eval($.npwp)" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="accountGroup" expression="json-eval($.Account_Group)" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:accountGroup) = 0">
        <then>
            <property name="accountGroup" expression="json-eval($.account_group)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:accountGroup) = 0">
        <then>
            <property name="accountGroup" expression="json-eval($.accountGroup)" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="top" expression="json-eval($.TOP)" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:top) = 0">
        <then>
            <property name="top" expression="json-eval($.top)" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="glAccount" expression="json-eval($.GL_Account)" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:glAccount) = 0">
        <then>
            <property name="glAccount" expression="json-eval($.gl_account)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:glAccount) = 0">
        <then>
            <property name="glAccount" expression="json-eval($.glAccount)" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="documentNumber" expression="json-eval($.DocumentNumber)" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:documentNumber) = 0">
        <then>
            <property name="documentNumber" expression="json-eval($.Document_Number)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:documentNumber) = 0">
        <then>
            <property name="documentNumber" expression="json-eval($.document_number)" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:documentNumber) = 0">
        <then>
            <property name="documentNumber" expression="json-eval($.documentNumber)" scope="default" type="STRING"/>
        </then>
    </filter>

    <!-- Client IP Extraction (X-Forwarded-For -> X-Real-IP -> default 127.0.0.1) -->
    <property name="clientIp" expression="$trp:X-Forwarded-For" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:clientIp) = 0">
        <then>
            <property name="clientIp" expression="$trp:X-Real-IP" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:clientIp) = 0">
        <then>
            <property name="clientIp" value="127.0.0.1" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="fn:contains($ctx:clientIp, ',')">
        <then>
            <property name="clientIp" expression="fn:normalize-space(fn:substring-before($ctx:clientIp, ','))" scope="default" type="STRING"/>
        </then>
    </filter>

    <!-- ================================================================= -->
    <!-- 2. Specifications & Field Validations                             -->
    <!-- ================================================================= -->
    <!-- Field: Vendor_ID (String, max 50 char, wajib) -->
    <filter xpath="string-length($ctx:vendorId) = 0 or string-length($ctx:vendorId) &gt; 50">
        <then>
            <property name="ERROR_CODE" value="400" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Bad Request" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Field 'Vendor_ID' wajib diisi dan maksimal 50 karakter" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>

    <!-- Field: Company_Code (String, max 100 char) -->
    <filter xpath="string-length($ctx:companyCode) &gt; 100">
        <then>
            <property name="ERROR_CODE" value="400" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Bad Request" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Field 'Company_Code' maksimal 100 karakter" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>

    <!-- Field: Company_Name (String, max 80 char, wajib) -->
    <filter xpath="string-length($ctx:companyName) = 0 or string-length($ctx:companyName) &gt; 80">
        <then>
            <property name="ERROR_CODE" value="400" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Bad Request" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Field 'Company_Name' wajib diisi dan maksimal 80 karakter" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>

    <!-- Field: Vendor_Type (String, max 50 char, wajib) -->
    <filter xpath="string-length($ctx:vendorType) = 0 or string-length($ctx:vendorType) &gt; 50">
        <then>
            <property name="ERROR_CODE" value="400" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Bad Request" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Field 'Vendor_Type' wajib diisi dan maksimal 50 karakter" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>

    <!-- Field: Bank Details (Account_Number max 18, Account_Name max 60, Bank_Name max 40, wajib) -->
    <filter xpath="string-length($ctx:accountNumber) = 0 or string-length($ctx:accountNumber) &gt; 18 or string-length($ctx:accountName) = 0 or string-length($ctx:accountName) &gt; 60 or string-length($ctx:bankName) = 0 or string-length($ctx:bankName) &gt; 40">
        <then>
            <property name="ERROR_CODE" value="400" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Bad Request" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Field 'Account_Number' (max 18), 'Account_Name' (max 60), dan 'Bank_Name' (max 40) wajib diisi" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>

    <!-- Field: HO_Email (Email valid, max 241 char, wajib) -->
    <filter xpath="string-length($ctx:hoEmail) = 0 or string-length($ctx:hoEmail) &gt; 241 or not(fn:contains($ctx:hoEmail, '@')) or not(fn:contains($ctx:hoEmail, '.'))">
        <then>
            <property name="ERROR_CODE" value="400" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Bad Request" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Field 'HO_Email' wajib diisi dengan format email valid dan maksimal 241 karakter" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>

    <!-- Field: HO_Phone (String, max 30 char, wajib) -->
    <filter xpath="string-length($ctx:hoPhone) = 0 or string-length($ctx:hoPhone) &gt; 30">
        <then>
            <property name="ERROR_CODE" value="400" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Bad Request" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Field 'HO_Phone' wajib diisi dan maksimal 30 karakter" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>

    <!-- Field: HO_Address (String, max 241 char, wajib) -->
    <filter xpath="string-length($ctx:hoAddress) = 0 or string-length($ctx:hoAddress) &gt; 241">
        <then>
            <property name="ERROR_CODE" value="400" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Bad Request" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Field 'HO_Address' wajib diisi dan maksimal 241 karakter" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>

    <!-- Field: Contact Details (Opsional: Contact_Name max 35, Contact_Phone max 16) -->
    <filter xpath="string-length($ctx:contactName) &gt; 35 or string-length($ctx:contactPhone) &gt; 16">
        <then>
            <property name="ERROR_CODE" value="400" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Bad Request" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Field 'Contact_Name' (max 35) atau 'Contact_Phone' (max 16) melebihi batas karakter" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>

    <!-- Field: NPWP (String, max 20 char, wajib) -->
    <filter xpath="string-length($ctx:npwp) = 0 or string-length($ctx:npwp) &gt; 20">
        <then>
            <property name="ERROR_CODE" value="400" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Bad Request" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Field 'NPWP' wajib diisi dan maksimal 20 karakter" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>

    <!-- Field: Account_Group (Enum: V010, V020, V030, wajib) -->
    <filter xpath="not($ctx:accountGroup = 'V010' or $ctx:accountGroup = 'V020' or $ctx:accountGroup = 'V030')">
        <then>
            <property name="ERROR_CODE" value="400" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Bad Request" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Field 'Account_Group' wajib diisi dengan kode valid (V010, V020, V030)" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>

    <!-- Field: TOP (Payment Terms, wajib) -->
    <filter xpath="string-length($ctx:top) = 0">
        <then>
            <property name="ERROR_CODE" value="400" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Bad Request" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Field 'TOP' wajib diisi dengan kode payment terms valid (mis. T014)" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>

    <!-- Field: GL_Account (GL Account SAP, wajib) -->
    <filter xpath="string-length($ctx:glAccount) = 0 or string-length($ctx:glAccount) &gt; 20">
        <then>
            <property name="ERROR_CODE" value="400" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Bad Request" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Field 'GL_Account' wajib diisi dengan kode GL account valid" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>

    <!-- Field: DocumentNumber (Vendor Document Number ATLAS, wajib) -->
    <filter xpath="string-length($ctx:documentNumber) = 0 or string-length($ctx:documentNumber) &gt; 50">
        <then>
            <property name="ERROR_CODE" value="400" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Bad Request" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Field 'DocumentNumber' wajib diisi dan maksimal 50 karakter" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>

    <!-- ================================================================= -->
    <!-- 3. Observability Logging & Idempotency Guard                      -->
    <!-- ================================================================= -->
    <property name="api.endpoint" value="/api/vendors/create" scope="default" type="STRING"/>
    <property name="api.params" expression="$ctx:originalPayload" scope="default" type="STRING"/>
    <sequence key="LogRequestSeq"/>
    <sequence key="IdempotencyGuardSeq"/>

    <!-- ================================================================= -->
    <!-- 4. Format TOP, Header Constants, and Build XML Payload            -->
    <!-- ================================================================= -->
    <!-- Resolve TOP (Payment Terms) clean code (e.g. T014) -->
    <filter xpath="fn:contains($ctx:top, ' - ')">
        <then>
            <property name="cleanTop" expression="fn:normalize-space(fn:substring-before($ctx:top, ' - '))" scope="default" type="STRING"/>
        </then>
        <else>
            <property name="cleanTop" expression="fn:normalize-space($ctx:top)" scope="default" type="STRING"/>
        </else>
    </filter>

    <!-- Resolve ATLAS Header Constants from config.properties with standard defaults -->
    <property name="atlasHeaderId" expression="get-property('file', 'atlas.header.id')" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:atlasHeaderId) = 0">
        <then>
            <property name="atlasHeaderId" value="ATLAS" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="atlasDestUser" expression="get-property('file', 'atlas.header.destinationUser')" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:atlasDestUser) = 0">
        <then>
            <property name="atlasDestUser" value="SAP" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="atlasKey1" expression="get-property('file', 'atlas.header.key1')" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:atlasKey1) = 0">
        <then>
            <property name="atlasKey1" value="ATLAS" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="atlasKey2" expression="get-property('file', 'atlas.header.key2.vmd')" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:atlasKey2) = 0">
        <then>
            <property name="atlasKey2" value="VMD" scope="default" type="STRING"/>
        </then>
    </filter>

    <!-- Generate TransGuID: yyyy-MM-dd HH:mm:ss-VMD -->
    <property name="transGuId" expression="fn:concat(get-property('SYSTEM_DATE', 'yyyy-MM-dd HH:mm:ss'), '-VMD')" scope="default" type="STRING"/>

    <!-- File Name Resolution: Allow X-File-Name header override or default VMD_{yyyyMMddHHmmss}.xml -->
    <property name="customFileName" expression="$trp:X-File-Name" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:customFileName) &gt; 0">
        <then>
            <property name="fileName" expression="$ctx:customFileName" scope="default" type="STRING"/>
        </then>
        <else>
            <property name="fileTimestamp" expression="get-property('SYSTEM_DATE', 'yyyyMMddHHmmss')" scope="default" type="STRING"/>
            <property name="fileName" expression="fn:concat('VMD_', $ctx:fileTimestamp, '.xml')" scope="default" type="STRING"/>
        </else>
    </filter>

    <!-- Build XML Target conforming strictly to ATLAS VMD schema via payloadFactory -->
    <payloadFactory media-type="xml">
        <format>
            <Transaction xmlns="">
                <Header>
                    <ID>$1</ID>
                    <TransGuID>$2</TransGuID>
                    <DocumentNumber>$3</DocumentNumber>
                    <FileType>XML</FileType>
                    <IPAddress>$4</IPAddress>
                    <DestinationUser>$5</DestinationUser>
                    <Key1>$6</Key1>
                    <Key2>$7</Key2>
                    <DataLength>1</DataLength>
                </Header>
                <TransactionDatas>
                    <TransactionData>
                        <Vendor_ID>$8</Vendor_ID>
                        <Company_Code>$9</Company_Code>
                        <Company_Name>$10</Company_Name>
                        <Vendor_Type>$11</Vendor_Type>
                        <Account_Number>$12</Account_Number>
                        <Account_Name>$13</Account_Name>
                        <Bank_Name>$14</Bank_Name>
                        <HO_Email>$15</HO_Email>
                        <HO_Phone>$16</HO_Phone>
                        <HO_Address>$17</HO_Address>
                        <Contact_Name>$18</Contact_Name>
                        <Contact_Phone>$19</Contact_Phone>
                        <NPWP>$20</NPWP>
                        <TOP>$21</TOP>
                        <Account_Group>$22</Account_Group>
                        <GL_Account>$23</GL_Account>
                    </TransactionData>
                </TransactionDatas>
            </Transaction>
        </format>
        <args>
            <arg evaluator="xml" expression="$ctx:atlasHeaderId"/>
            <arg evaluator="xml" expression="$ctx:transGuId"/>
            <arg evaluator="xml" expression="$ctx:documentNumber"/>
            <arg evaluator="xml" expression="$ctx:clientIp"/>
            <arg evaluator="xml" expression="$ctx:atlasDestUser"/>
            <arg evaluator="xml" expression="$ctx:atlasKey1"/>
            <arg evaluator="xml" expression="$ctx:atlasKey2"/>
            <arg evaluator="xml" expression="$ctx:vendorId"/>
            <arg evaluator="xml" expression="$ctx:companyCode"/>
            <arg evaluator="xml" expression="$ctx:companyName"/>
            <arg evaluator="xml" expression="$ctx:vendorType"/>
            <arg evaluator="xml" expression="$ctx:accountNumber"/>
            <arg evaluator="xml" expression="$ctx:accountName"/>
            <arg evaluator="xml" expression="$ctx:bankName"/>
            <arg evaluator="xml" expression="$ctx:hoEmail"/>
            <arg evaluator="xml" expression="$ctx:hoPhone"/>
            <arg evaluator="xml" expression="$ctx:hoAddress"/>
            <arg evaluator="xml" expression="$ctx:contactName"/>
            <arg evaluator="xml" expression="$ctx:contactPhone"/>
            <arg evaluator="xml" expression="$ctx:npwp"/>
            <arg evaluator="xml" expression="$ctx:cleanTop"/>
            <arg evaluator="xml" expression="$ctx:accountGroup"/>
            <arg evaluator="xml" expression="$ctx:glAccount"/>
        </args>
    </payloadFactory>

    <!-- Pretty-print XML structure with indentations & newlines for human readability & WinSCP -->
    <xslt key="XmlPrettyPrintXslt"/>

    <!-- ================================================================= -->
    <!-- 5. Resolve Dynamic VFS FTP Destination (4-Layer Chain)            -->
    <!-- ================================================================= -->
    <!-- Layer 1: ENV -->
    <property name="ftpHost" expression="get-property('env', 'FTP_SAP_HOST')" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:ftpHost) = 0">
        <then>
            <!-- Layer 2: System -->
            <property name="ftpHost" expression="get-property('system', 'ftp.vendor.host')" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:ftpHost) = 0">
        <then>
            <!-- Layer 3: File -->
            <property name="ftpHost" expression="get-property('file', 'ftp.vendor.host')" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:ftpHost) = 0">
        <then>
            <!-- Layer 4: Fallback -->
            <property name="ftpHost" value="devqaxmlpool.assa.id" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="ftpPort" expression="get-property('env', 'FTP_SAP_PORT')" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:ftpPort) = 0">
        <then>
            <property name="ftpPort" expression="get-property('system', 'ftp.vendor.port')" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:ftpPort) = 0">
        <then>
            <property name="ftpPort" expression="get-property('file', 'ftp.vendor.port')" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:ftpPort) = 0">
        <then>
            <property name="ftpPort" value="21" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="ftpUsername" expression="get-property('env', 'FTP_SAP_USERNAME')" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:ftpUsername) = 0">
        <then>
            <property name="ftpUsername" expression="get-property('system', 'ftp.vendor.username')" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:ftpUsername) = 0">
        <then>
            <property name="ftpUsername" expression="get-property('file', 'ftp.vendor.username')" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="ftpPassword" expression="get-property('env', 'FTP_SAP_PASSWORD')" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:ftpPassword) = 0">
        <then>
            <property name="ftpPassword" expression="get-property('system', 'ftp.vendor.password')" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:ftpPassword) = 0">
        <then>
            <property name="ftpPassword" expression="get-property('file', 'ftp.vendor.password')" scope="default" type="STRING"/>
        </then>
    </filter>

    <!-- Priority resolution for directory: ENV -> VMD remote dir -> vendor remote dir -> fallback /vmd -->
    <property name="ftpTargetDir" expression="get-property('env', 'FTP_SAP_TARGET')" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:ftpTargetDir) = 0">
        <then>
            <property name="ftpTargetDir" expression="get-property('system', 'ftp.vendor.vmd.remote.dir')" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:ftpTargetDir) = 0">
        <then>
            <property name="ftpTargetDir" expression="get-property('file', 'ftp.vendor.vmd.remote.dir')" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:ftpTargetDir) = 0">
        <then>
            <property name="ftpTargetDir" expression="get-property('system', 'ftp.vendor.remote.dir')" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:ftpTargetDir) = 0">
        <then>
            <property name="ftpTargetDir" expression="get-property('file', 'ftp.vendor.remote.dir')" scope="default" type="STRING"/>
        </then>
    </filter>
    <filter xpath="string-length($ctx:ftpTargetDir) = 0">
        <then>
            <property name="ftpTargetDir" value="/vmd" scope="default" type="STRING"/>
        </then>
    </filter>

    <!-- Fail closed: reject when the FTP connection cannot be fully resolved from
         configuration, instead of building a malformed VFS URI. -->
    <filter xpath="string-length($ctx:ftpHost) = 0 or string-length($ctx:ftpPort) = 0 or string-length($ctx:ftpUsername) = 0 or string-length($ctx:ftpPassword) = 0 or string-length($ctx:ftpTargetDir) = 0">
        <then>
            <property name="ERROR_CODE" value="500" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="FTP Configuration Error" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Vendor FTP upload configuration is incomplete" scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>

    <!-- Clean leading slash from ftpTargetDir if necessary -->
    <filter xpath="fn:starts-with($ctx:ftpTargetDir, '/')">
        <then>
            <property name="cleanFtpDir" expression="fn:substring($ctx:ftpTargetDir, 2)" scope="default" type="STRING"/>
        </then>
        <else>
            <property name="cleanFtpDir" expression="$ctx:ftpTargetDir" scope="default" type="STRING"/>
        </else>
    </filter>

    <!-- URL-encode password character '#' to '%23' for standard RFC URI parsing -->
    <filter xpath="fn:contains($ctx:ftpPassword, '#')">
        <then>
            <property name="ftpPasswordEncoded" expression="fn:concat(fn:substring-before($ctx:ftpPassword, '#'), '%23', fn:substring-after($ctx:ftpPassword, '#'))" scope="default" type="STRING"/>
        </then>
        <else>
            <property name="ftpPasswordEncoded" expression="$ctx:ftpPassword" scope="default" type="STRING"/>
        </else>
    </filter>

    <!-- Construct final VFS URI: vfs:ftp://user:pass@host:port/dir?vfs.passive=true -->
    <property name="ftpTargetUrl" expression="fn:concat('vfs:ftp://', $ctx:ftpUsername, ':', $ctx:ftpPasswordEncoded, '@', $ctx:ftpHost, ':', $ctx:ftpPort, '/', $ctx:cleanFtpDir, '?vfs.passive=true')" scope="default" type="STRING"/>

    <!-- Set VFS Transport Parameters -->
    <header name="To" expression="$ctx:ftpTargetUrl" scope="default"/>
    <property name="transport.vfs.ReplyFileName" expression="$ctx:fileName" scope="transport"/>
    <property name="OUT_ONLY" value="true" scope="default"/>
    <property name="messageType" value="application/xml" scope="axis2"/>
    <property name="ContentType" value="application/xml" scope="axis2"/>
    <property name="NO_SOAP_ENVELOPE" value="true" scope="axis2"/>

    <!-- ================================================================= -->
    <!-- 6. Invoke SafeApiCallWithRetrySeq with VendorFtpEndpoint          -->
    <!-- ================================================================= -->
    <property name="targetEndpointKey" value="VendorFtpEndpoint" scope="default" type="STRING"/>
    <sequence key="SafeApiCallWithRetrySeq"/>
</sequence>
