<?xml version="1.0" encoding="UTF-8"?>
<api context="/api/payments" name="PaymentsAPI" xmlns="http://ws.apache.org/ns/synapse">
    <!-- ================================================================= -->
    <!-- Payments Domain API (File-based FTP Interface)                    -->
    <!-- Referensi: GUIDE_PAYMENTS_CREATE_XML_FTP.md                       -->
    <!-- ================================================================= -->
    <resource methods="POST" url-mapping="/*">
        <inSequence>
            <!-- 1. Mandatory Token Authentication (Auth Guard with scope: payments) -->
            <property name="requiredScope" value="payments" scope="default" type="STRING"/>
            <sequence key="AuthGuardSeq"/>

            <!-- 2. Domain Orchestration Sequence -->
            <sequence key="PaymentsCreateSeq"/>
        </inSequence>
        <faultSequence>
            <sequence key="ErrorResponseSeq"/>
        </faultSequence>
    </resource>
</api>
