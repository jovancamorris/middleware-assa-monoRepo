<?xml version="1.0" encoding="UTF-8"?>
<sequence name="ApDueListInboundFaultSeq" trace="disable" xmlns="http://ws.apache.org/ns/synapse">
    <!-- ================================================================= -->
    <!-- AP Due List Inbound Poller Fault Sequence                         -->
    <!-- Memindahkan berkas XML bermasalah ke /apduelist/upload/failed/    -->
    <!-- Referensi: notes/GUIDE_AP_DUE_LIST_XML_FTP.md Bab 6.1 & 8.3       -->
    <!-- ================================================================= -->
    <property name="SET_ROLLBACK_ONLY" value="true" scope="axis2"/>
    <property name="SET_ROLLBACK_ONLY" value="true" scope="default"/>
    <log level="custom">
        <property name="AP_RECON_FAULT" value="Kegagalan pemrosesan file XML balikan SAP di /apduelist/upload"/>
        <property name="ERROR_CODE" expression="$ctx:ERROR_CODE"/>
        <property name="ERROR_MESSAGE" expression="$ctx:ERROR_MESSAGE"/>
        <property name="ERROR_DETAIL" expression="$ctx:ERROR_DETAIL"/>
    </log>
    <drop/>
</sequence>
