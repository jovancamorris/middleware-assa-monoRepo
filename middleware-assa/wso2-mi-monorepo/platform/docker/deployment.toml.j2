# ==============================================================================
# Base Configuration Template — WSO2 Micro Integrator (Jinja2)
# Dipakai sebagai template dasar untuk SEMUA service integrasi.
# Placeholder {{ ... }} dirender per-environment (dev/qa/prod) oleh pipeline /
# config renderer sebelum image dibuild atau saat container start.
# ==============================================================================

[server]
hostname = "{{ SERVER_HOSTNAME | default('localhost') }}"

[user_store]
type = "read_only_ldap"

[keystore.primary]
file_name = "repository/resources/security/wso2carbon.jks"
password = "{{ KEYSTORE_PASSWORD | default('wso2carbon') }}"      # secret-detector:ignore
alias = "wso2carbon"
key_password = "{{ KEYSTORE_KEY_PASSWORD | default('wso2carbon') }}"  # secret-detector:ignore

[truststore]
file_name = "repository/resources/security/client-truststore.jks"
password = "{{ TRUSTSTORE_PASSWORD | default('wso2carbon') }}"    # secret-detector:ignore
alias = "symmetric.key.value"
algorithm = "AES"

# ---- VFS transport (untuk service yang menulis file ke FTP: vendor, spk) ----
[transport.vfs]
listener_enable = {{ VFS_LISTENER_ENABLE | default('false') }}
sender_enable = {{ VFS_SENDER_ENABLE | default('false') }}

# ---- System parameters: base URLs & DB (di-inject per environment) ----
[system.parameter]
'sap.core.base.url' = "{{ SAP_CORE_BASE_URL | default('https://devsapcoreapi.assa.id') }}"
'sap.core.customer.base.url' = "{{ SAP_CORE_CUSTOMER_BASE_URL | default('https://sapcoreapi.assa.id') }}"
'assa.ext.base.url' = "{{ ASSA_EXT_BASE_URL | default('https://assa-ext-services.assa.id/qa') }}"
'db.driver' = "org.mariadb.jdbc.Driver"
'db.url' = "jdbc:mariadb://{{ DB_HOST | default('localhost') }}:{{ DB_PORT | default('3307') }}/assa_middleware_db?useSSL=false&allowPublicKeyRetrieval=true"
'db.username' = "{{ DB_USERNAME | default('root') }}"
'db.password' = "{{ DB_PASSWORD | default('') }}"     # secret-detector:ignore — gunakan Secure Vault / Secret di produksi
'retry.max.attempts' = "{{ RETRY_MAX_ATTEMPTS | default('3') }}"
'retry.interval.seconds' = "{{ RETRY_INTERVAL_SECONDS | default('60') }}"
'vehicleatlas.base.url' = "{{ VEHICLEATLAS_BASE_URL | default('https://devfmsapi.assa.id') }}"
'assa.api.path.vehicle' = "{{ ASSA_API_PATH_VEHICLE | default('/api/vehicleatlas') }}"
'vehicleatlas.apikey' = "{{ ASSA_EXT_VEHICLE_APIKEY | default('$env{ASSA_EXT_VEHICLE_APIKEY}') }}"
'assa.ext.vehicle.apikey' = "{{ ASSA_EXT_VEHICLE_APIKEY | default('$env{ASSA_EXT_VEHICLE_APIKEY}') }}"
'ftp.vendor.host' = "{{ FTP_SAP_HOST | default('devqaxmlpool.assa.id') }}"
'ftp.vendor.port' = "{{ FTP_SAP_PORT | default('21') }}"
'ftp.vendor.username' = "{{ FTP_SAP_USERNAME | default('middlewaredev') }}"
'ftp.vendor.password' = "{{ FTP_SAP_PASSWORD | default('$env{FTP_SAP_PASSWORD}') }}"
'ftp.vendor.remote.dir' = "{{ FTP_SAP_TARGET | default('/vmd') }}"
'ftp.vendor.vmd.remote.dir' = "{{ FTP_SAP_TARGET | default('/vmd') }}"
'ftp.vendor.passive' = "true"
'ftp.vendor.protocol' = "ftp"
'ftp.spk.host' = "{{ FTP_SPK_HOST | default('devqaxmlpool.assa.id') }}"
'ftp.spk.port' = "{{ FTP_SPK_PORT | default('21') }}"
'ftp.spk.username' = "{{ FTP_SPK_USERNAME | default('middlewaredev') }}"
'ftp.spk.password' = "{{ FTP_SPK_PASSWORD | default('$env{FTP_SPK_PASSWORD}') }}"
'ftp.spk.remote.dir' = "{{ FTP_SPK_TARGET | default('/duelist') }}"
'ftp.spk.staging.dir' = "{{ FTP_SPK_STAGING | default('/inbound/spk/.staging') }}"
'ftp.spk.protocol' = "ftp"
'ftp.spk.passive' = "true"
'atlas.header.id' = "ATLAS"
'atlas.header.destinationUser' = "SAP"
'atlas.header.key1' = "ATLAS"
'atlas.header.key2.spk' = "SPK"
'assa.ext.sr.base.url' = "{{ ASSA_EXT_SR_BASE_URL | default('https://assa-ext-services.assa.id/dev') }}"
'assa.api.path.service_request' = "/service/input_service_request"
'assa.ext.sr.apikey' = "{{ ASSA_EXT_SR_APIKEY | default('$env{ASSA_EXT_SR_APIKEY}') }}"
'sr.target.atlas.enabled' = "{{ SR_TARGET_ATLAS_ENABLED | default('false') }}"
'sr.target.atlas.base.url' = "{{ SR_TARGET_ATLAS_BASE_URL | default('https://atlas-api.assa.id/dev') }}"
'sr.target.atlas.path' = "/service-request"
'sr.target.atlas.apikey' = "{{ SR_TARGET_ATLAS_APIKEY | default('$env{SR_TARGET_ATLAS_APIKEY}') }}"
'sr.target.extservice.enabled' = "{{ SR_TARGET_EXTSERVICE_ENABLED | default('true') }}"
'auth.app.app_a.token' = "{{ AUTH_APP_A_TOKEN | default('$env{AUTH_APP_A_TOKEN}') }}"
'auth.app.app_b.token' = "{{ AUTH_APP_B_TOKEN | default('$env{AUTH_APP_B_TOKEN}') }}"
'auth.app.app_qa.token' = "{{ AUTH_APP_QA_TOKEN | default('$env{AUTH_APP_QA_TOKEN}') }}"
'auth.app.app_atlas.token' = "{{ AUTH_APP_ATLAS_TOKEN | default('$env{AUTH_APP_ATLAS_TOKEN}') }}"
'auth.app.app_omnichannel.token' = "{{ AUTH_APP_OMNICHANNEL_TOKEN | default('$env{AUTH_APP_OMNICHANNEL_TOKEN}') }}"
'auth.app.app_omnichannel.scopes' = "service_requests"

