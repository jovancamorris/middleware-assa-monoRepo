<?xml version="1.0" encoding="UTF-8"?>
<sequence name="AuthGuardSeq" trace="disable" xmlns="http://ws.apache.org/ns/synapse">
    <property name="correlationId" expression="$trp:X-Correlation-Id" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:correlationId) = 0">
        <then>
            <property name="correlationId" expression="fn:concat('corr-', get-property('SYSTEM_DATE', 'yyyyMMddHHmmssSSS'))" scope="default" type="STRING"/>
        </then>
    </filter>
    <header name="X-Correlation-Id" expression="$ctx:correlationId" scope="transport"/>

    <property name="authHeader" expression="$trp:Authorization" scope="default" type="STRING"/>
    <property name="apiKeyHeader" expression="$trp:X-API-Key" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:apiKeyHeader) = 0">
        <then>
            <property name="apiKeyHeader" expression="$trp:x-api-key" scope="default" type="STRING"/>
        </then>
    </filter>

    <property name="bearerToken" value="" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:authHeader) &gt; 0 and fn:starts-with($ctx:authHeader, 'Bearer ')">
        <then>
            <property name="bearerToken" expression="fn:normalize-space(fn:substring-after($ctx:authHeader, 'Bearer '))" scope="default" type="STRING"/>
        </then>
        <else>
            <filter xpath="string-length($ctx:apiKeyHeader) &gt; 0">
                <then>
                    <property name="bearerToken" expression="fn:normalize-space($ctx:apiKeyHeader)" scope="default" type="STRING"/>
                </then>
            </filter>
        </else>
    </filter>

    <filter xpath="string-length($ctx:bearerToken) = 0">
        <then>
            <property name="ERROR_CODE" value="401" scope="default" type="STRING"/>
            <property name="ERROR_MESSAGE" value="Unauthorized" scope="default" type="STRING"/>
            <property name="ERROR_DETAIL" value="Authentication required. Please provide 'Authorization: Bearer &lt;token&gt;' or 'X-API-Key: &lt;token&gt;'." scope="default" type="STRING"/>
            <sequence key="ErrorResponseSeq"/>
            <drop/>
        </then>
    </filter>

    <property name="tokenAppA" expression="get-property('env', 'AUTH_APP_A_TOKEN')" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:tokenAppA) = 0"><then><property name="tokenAppA" expression="get-property('system', 'auth.app.app_a.token')" scope="default" type="STRING"/></then></filter>
    <filter xpath="string-length($ctx:tokenAppA) = 0"><then><property name="tokenAppA" expression="get-property('file', 'auth.app.app_a.token')" scope="default" type="STRING"/></then></filter>
    <filter xpath="string-length($ctx:tokenAppA) = 0"><then><property name="tokenAppA" value="c220fbfbc7e4c925eb662d85be47ee5ab017d23d9b04f7c22df6cb7efb6dfdbd" scope="default" type="STRING"/></then></filter>

    <property name="tokenAppB" expression="get-property('env', 'AUTH_APP_B_TOKEN')" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:tokenAppB) = 0"><then><property name="tokenAppB" expression="get-property('system', 'auth.app.app_b.token')" scope="default" type="STRING"/></then></filter>
    <filter xpath="string-length($ctx:tokenAppB) = 0"><then><property name="tokenAppB" expression="get-property('file', 'auth.app.app_b.token')" scope="default" type="STRING"/></then></filter>
    <filter xpath="string-length($ctx:tokenAppB) = 0"><then><property name="tokenAppB" value="988316b38c88b941600c40aae26ed8429a64d0c1c9a73b596f044da40c911881" scope="default" type="STRING"/></then></filter>

    <property name="tokenAppQA" expression="get-property('env', 'AUTH_APP_QA_TOKEN')" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:tokenAppQA) = 0"><then><property name="tokenAppQA" expression="get-property('system', 'auth.app.app_qa.token')" scope="default" type="STRING"/></then></filter>
    <filter xpath="string-length($ctx:tokenAppQA) = 0"><then><property name="tokenAppQA" expression="get-property('file', 'auth.app.app_qa.token')" scope="default" type="STRING"/></then></filter>
    <filter xpath="string-length($ctx:tokenAppQA) = 0"><then><property name="tokenAppQA" value="e20b33b006bc229d49dd701c385f8abfbe6a24726fb51db11624bce3766627be" scope="default" type="STRING"/></then></filter>

    <property name="tokenAppAtlas" expression="get-property('env', 'AUTH_APP_ATLAS_TOKEN')" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:tokenAppAtlas) = 0"><then><property name="tokenAppAtlas" expression="get-property('system', 'auth.app.app_atlas.token')" scope="default" type="STRING"/></then></filter>
    <filter xpath="string-length($ctx:tokenAppAtlas) = 0"><then><property name="tokenAppAtlas" expression="get-property('file', 'auth.app.app_atlas.token')" scope="default" type="STRING"/></then></filter>
    <filter xpath="string-length($ctx:tokenAppAtlas) = 0"><then><property name="tokenAppAtlas" value="ik4lcTGsZx1hARMWOoy613tAkI7Mcj7q1g7PRq3d" scope="default" type="STRING"/></then></filter>

    <property name="tokenAppBarantum" expression="get-property('env', 'AUTH_APP_BARANTUM_TOKEN')" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:tokenAppBarantum) = 0"><then><property name="tokenAppBarantum" expression="get-property('system', 'auth.app.app_barantum.token')" scope="default" type="STRING"/></then></filter>
    <filter xpath="string-length($ctx:tokenAppBarantum) = 0"><then><property name="tokenAppBarantum" expression="get-property('file', 'auth.app.app_barantum.token')" scope="default" type="STRING"/></then></filter>
    <filter xpath="string-length($ctx:tokenAppBarantum) = 0"><then><property name="tokenAppBarantum" value="umk_da295902028f5804c4f0e9d9fd81fa07a2a0e1152d6171e30f387416fbfe5680" scope="default" type="STRING"/></then></filter>

    <property name="tokenAppOmnichannel" expression="get-property('env', 'AUTH_APP_OMNICHANNEL_TOKEN')" scope="default" type="STRING"/>
    <filter xpath="string-length($ctx:tokenAppOmnichannel) = 0"><then><property name="tokenAppOmnichannel" expression="get-property('system', 'auth.app.app_omnichannel.token')" scope="default" type="STRING"/></then></filter>
    <filter xpath="string-length($ctx:tokenAppOmnichannel) = 0"><then><property name="tokenAppOmnichannel" expression="get-property('file', 'auth.app.app_omnichannel.token')" scope="default" type="STRING"/></then></filter>
    <filter xpath="string-length($ctx:tokenAppOmnichannel) = 0"><then><property name="tokenAppOmnichannel" value="14066ba5b0f51e031a9feaae644fc13f2ada2fb4be9ee054f96b8865fb7a6f12" scope="default" type="STRING"/></then></filter>

    <filter xpath="string-length($ctx:tokenAppBarantum) &gt; 0 and $ctx:bearerToken = $ctx:tokenAppBarantum">
        <then>
            <property name="appId" value="app_barantum" scope="default" type="STRING"/>
            <property name="appScopes" expression="get-property('file', 'auth.app.app_barantum.scopes')" scope="default" type="STRING"/>
            <filter xpath="string-length($ctx:appScopes) = 0"><then><property name="appScopes" expression="get-property('system', 'auth.app.app_barantum.scopes')" scope="default" type="STRING"/></then></filter>
            <filter xpath="string-length($ctx:appScopes) = 0"><then><property name="appScopes" value="service_requests" scope="default" type="STRING"/></then></filter>
        </then>
        <else>
            <filter xpath="string-length($ctx:tokenAppA) &gt; 0 and $ctx:bearerToken = $ctx:tokenAppA">
                <then>
                    <property name="appId" value="app_a" scope="default" type="STRING"/>
                    <property name="appScopes" expression="get-property('file', 'auth.app.app_a.scopes')" scope="default" type="STRING"/>
                    <filter xpath="string-length($ctx:appScopes) = 0"><then><property name="appScopes" expression="get-property('system', 'auth.app.app_a.scopes')" scope="default" type="STRING"/></then></filter>
                    <filter xpath="string-length($ctx:appScopes) = 0"><then><property name="appScopes" value="branches,customers,vehicles,vendors,service_requests,spk" scope="default" type="STRING"/></then></filter>
                </then>
                <else>
                    <filter xpath="string-length($ctx:tokenAppB) &gt; 0 and $ctx:bearerToken = $ctx:tokenAppB">
                        <then>
                            <property name="appId" value="app_b" scope="default" type="STRING"/>
                            <property name="appScopes" expression="get-property('file', 'auth.app.app_b.scopes')" scope="default" type="STRING"/>
                            <filter xpath="string-length($ctx:appScopes) = 0"><then><property name="appScopes" expression="get-property('system', 'auth.app.app_b.scopes')" scope="default" type="STRING"/></then></filter>
                            <filter xpath="string-length($ctx:appScopes) = 0"><then><property name="appScopes" value="vehicles" scope="default" type="STRING"/></then></filter>
                        </then>
                        <else>
                            <filter xpath="string-length($ctx:tokenAppQA) &gt; 0 and $ctx:bearerToken = $ctx:tokenAppQA">
                                <then>
                                    <property name="appId" value="app_qa" scope="default" type="STRING"/>
                                    <property name="appScopes" expression="get-property('file', 'auth.app.app_qa.scopes')" scope="default" type="STRING"/>
                                    <filter xpath="string-length($ctx:appScopes) = 0"><then><property name="appScopes" expression="get-property('system', 'auth.app.app_qa.scopes')" scope="default" type="STRING"/></then></filter>
                                    <filter xpath="string-length($ctx:appScopes) = 0"><then><property name="appScopes" value="branches,customers,vehicles,vendors,service_requests,spk" scope="default" type="STRING"/></then></filter>
                                </then>
                                <else>
                                    <filter xpath="string-length($ctx:tokenAppAtlas) &gt; 0 and $ctx:bearerToken = $ctx:tokenAppAtlas">
                                        <then>
                                            <property name="appId" value="app_atlas" scope="default" type="STRING"/>
                                            <property name="appScopes" expression="get-property('file', 'auth.app.app_atlas.scopes')" scope="default" type="STRING"/>
                                            <filter xpath="string-length($ctx:appScopes) = 0"><then><property name="appScopes" expression="get-property('system', 'auth.app.app_atlas.scopes')" scope="default" type="STRING"/></then></filter>
                                            <filter xpath="string-length($ctx:appScopes) = 0"><then><property name="appScopes" value="vendors" scope="default" type="STRING"/></then></filter>
                                        </then>
                                        <else>
                                            <filter xpath="string-length($ctx:tokenAppOmnichannel) &gt; 0 and $ctx:bearerToken = $ctx:tokenAppOmnichannel">
                                                <then>
                                                    <property name="appId" value="app_omnichannel" scope="default" type="STRING"/>
                                                    <property name="appScopes" expression="get-property('file', 'auth.app.app_omnichannel.scopes')" scope="default" type="STRING"/>
                                                    <filter xpath="string-length($ctx:appScopes) = 0"><then><property name="appScopes" expression="get-property('system', 'auth.app.app_omnichannel.scopes')" scope="default" type="STRING"/></then></filter>
                                                    <filter xpath="string-length($ctx:appScopes) = 0"><then><property name="appScopes" value="service_requests" scope="default" type="STRING"/></then></filter>
                                                </then>
                                                <else>
                                                    <property name="ERROR_CODE" value="401" scope="default" type="STRING"/>
                                                    <property name="ERROR_MESSAGE" value="Unauthorized" scope="default" type="STRING"/>
                                                    <property name="ERROR_DETAIL" value="Token is invalid or unknown." scope="default" type="STRING"/>
                                                    <sequence key="ErrorResponseSeq"/>
                                                    <drop/>
                                                </else>
                                            </filter>
                                        </else>
                                    </filter>
                                </else>
                            </filter>
                        </else>
                    </filter>
                </else>
            </filter>
        </else>
    </filter>

    <filter xpath="boolean($ctx:requiredScope)">
        <then>
            <filter xpath="not(fn:contains($ctx:appScopes, $ctx:requiredScope)) and not(fn:contains($ctx:appScopes, '*'))">
                <then>
                    <property name="ERROR_CODE" value="403" scope="default" type="STRING"/>
                    <property name="ERROR_MESSAGE" value="Forbidden" scope="default" type="STRING"/>
                    <property name="ERROR_DETAIL" expression="fn:concat('Application (', $ctx:appId, ') does not have scope: ', $ctx:requiredScope)" scope="default" type="STRING"/>
                    <sequence key="ErrorResponseSeq"/>
                    <drop/>
                </then>
            </filter>
        </then>
    </filter>
</sequence>
