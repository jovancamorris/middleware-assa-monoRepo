# ==============================================================================
# ASSA MIDDLEWARE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Salin file ini menjadi '.env' dan isi dengan kredensial yang sesuai untuk lokal:
#   copy .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Hosts & Base URLs
# ------------------------------------------------------------------------------
SAP_CORE_BASE_URL=https://devsapcoreapi.assa.id
SAP_CORE_CUSTOMER_BASE_URL=https://sapcoreapi.assa.id
ASSA_EXT_BASE_URL=https://devfmsapi.assa.id
ASSA_EXT_SR_BASE_URL=https://assa-ext-services.assa.id/dev
SR_TARGET_ATLAS_BASE_URL=https://atlas-api.assa.id/dev

# ------------------------------------------------------------------------------
# 2. External Service API Keys
# ------------------------------------------------------------------------------
ASSA_EXT_VEHICLE_APIKEY=your_vehicle_api_key_here
ASSA_EXT_SR_APIKEY=your_sr_api_key_here
SR_TARGET_ATLAS_APIKEY=your_atlas_api_key_here

# ------------------------------------------------------------------------------
# 3. Application Registry Authentication Tokens (Bearer Tokens - SHA-256 Hex 64-char)
# ------------------------------------------------------------------------------
AUTH_APP_A_TOKEN=your_app_a_token_here
AUTH_APP_B_TOKEN=your_app_b_token_here
AUTH_APP_QA_TOKEN=your_app_qa_token_here
AUTH_APP_ATLAS_TOKEN=your_app_atlas_token_here
AUTH_APP_OMNICHANNEL_TOKEN=your_app_omnichannel_token_here

# ------------------------------------------------------------------------------
# 4. Database Configuration (MariaDB / MySQL)
# ------------------------------------------------------------------------------
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=assa_middleware_db
DB_USERNAME=root
DB_PASSWORD=
COMPOSE_DB_PORT=3308
DB_IMAGE=mysql:8.0

# ------------------------------------------------------------------------------
# 5. FTP SAP Vendor Interface (VMD) & SPK Interface
# ------------------------------------------------------------------------------
FTP_SAP_HOST=devqaxmlpool.assa.id
FTP_SAP_PORT=21
FTP_SAP_TARGET=/vmd
FTP_SAP_USERNAME=your_ftp_username_here
FTP_SAP_PASSWORD=your_ftp_password_here

FTP_SPK_HOST=devqaxmlpool.assa.id
FTP_SPK_PORT=21
FTP_SPK_TARGET=/duelist
FTP_SPK_USERNAME=your_ftp_username_here
FTP_SPK_PASSWORD=your_ftp_password_here

# ------------------------------------------------------------------------------
# 6. Feature Flags
# ------------------------------------------------------------------------------
SR_TARGET_ATLAS_ENABLED=false
SR_TARGET_EXTSERVICE_ENABLED=true
