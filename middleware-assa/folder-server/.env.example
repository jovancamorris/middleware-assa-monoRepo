# ==============================================================================
# ASSA MIDDLEWARE ENVIRONMENT VARIABLES (.env)
# Salin file ini menjadi `.env` di folder server (/var/www/devmiddleware/.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Container Images & Ports
# ------------------------------------------------------------------------------
MI_IMAGE=registry.assa.id/nobi.sumariga/middleware-assa:1.0.6
DB_IMAGE=mariadb:11
COMPOSE_DB_PORT=3308
NGINX_HTTP_PORT=6031

# ------------------------------------------------------------------------------
# 2. Database Configuration (MariaDB)
# ------------------------------------------------------------------------------
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=assa_middleware_db
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------------------
# 3. Backend Hosts & External Base URLs
# ------------------------------------------------------------------------------
SAP_CORE_BASE_URL=https://devsapcoreapi.assa.id
SAP_CORE_CUSTOMER_BASE_URL=https://sapcoreapi.assa.id
ASSA_EXT_BASE_URL=https://devfmsapi.assa.id
ASSA_EXT_SR_BASE_URL=https://assa-ext-services.assa.id/dev
SR_TARGET_ATLAS_BASE_URL=https://atlas-api.assa.id/dev

# ------------------------------------------------------------------------------
# 4. External Service API Keys
# ------------------------------------------------------------------------------
ASSA_EXT_VEHICLE_APIKEY=
ASSA_EXT_SR_APIKEY=
SR_TARGET_ATLAS_APIKEY=

# ------------------------------------------------------------------------------
# 5. Application Registry Authentication Tokens (Bearer Tokens)
# ------------------------------------------------------------------------------
AUTH_APP_A_TOKEN=
AUTH_APP_B_TOKEN=
AUTH_APP_QA_TOKEN=
AUTH_APP_ATLAS_TOKEN=
AUTH_APP_OMNICHANNEL_TOKEN=

# ------------------------------------------------------------------------------
# 6. FTP SAP Vendor Interface (VMD) & SPK Interface
# ------------------------------------------------------------------------------
FTP_SAP_HOST=devqaxmlpool.assa.id
FTP_SAP_PORT=21
FTP_SAP_TARGET=/vmd
FTP_SAP_USERNAME=
FTP_SAP_PASSWORD=

FTP_SPK_HOST=devqaxmlpool.assa.id
FTP_SPK_PORT=21
FTP_SPK_TARGET=/duelist
FTP_SPK_USERNAME=
FTP_SPK_PASSWORD=

# ------------------------------------------------------------------------------
# 7. Feature Flags
# ------------------------------------------------------------------------------
SR_TARGET_ATLAS_ENABLED=false
SR_TARGET_EXTSERVICE_ENABLED=true
